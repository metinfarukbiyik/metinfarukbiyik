# Yazıların nereden çekileceğini belirler: demo | sanity | notion
BLOG_SOURCE=demo

# Sanity kullanılacaksa (proje kimliği sanity.io/manage adresinde görünür)
# NEXT_PUBLIC_SANITY_PROJECT_ID=
# NEXT_PUBLIC_SANITY_DATASET=production

# Notion kullanılacaksa
# NOTION_TOKEN=
# NOTION_DATABASE_ID=

# CMS webhook'unun siteyi tazelemesi için paylaşılan gizli anahtar
# REVALIDATE_SECRET=
